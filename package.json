{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-mastra-om",
  "version": "0.1.46",
  "type": "module",
  "license": "MIT",
  "description": "Observational memory plugin for OpenCode, built on Mastra",
  "keywords": [
    "opencode",
    "plugin",
    "memory",
    "mastra",
    "observational-memory"
  ],
  "author": "Rick Ross",
  "repository": {
    "type": "git",
    "url": "https://github.com/rickross/opencode-mastra-om"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "opencode": {
    "type": "plugin",
    "hooks": [
      "tool",
      "experimental.chat.messages.transform",
      "experimental.chat.system.transform",
      "event"
    ]
  },
  "dependencies": {
    "@mastra/core": "1.55.0",
    "@mastra/libsql": "1.18.0",
    "@mastra/memory": "1.24.0",
    "@opencode-ai/plugin": "^1.3.11",
    "@opencode-ai/sdk": "^1.3.11"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node --external @opencode-ai/plugin --external @opencode-ai/sdk && bun build ./src/replay-opencode-session.ts --outfile ./dist/replay-opencode-session.js --target bun --packages external",
    "typecheck": "tsc --noEmit",
    "replay:opencode": "bun ./dist/replay-opencode-session.js",
    "selftest:replay": "bun ./src/replay-opencode-session.selftest.ts",
    "selftest:fixture": "bun ./src/replay-irl-fixture.selftest.ts",
    "prepublishOnly": "bun run build"
  }
}
